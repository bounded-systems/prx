{
  "$ref": "#/definitions/transition_contract",
  "definitions": {
    "transition_contract": {
      "type": "object",
      "properties": {
        "axis": {
          "type": "string",
          "enum": [
            "role",
            "workflow",
            "lifecycle"
          ]
        },
        "fromPhase": {
          "type": "string",
          "minLength": 1
        },
        "toPhase": {
          "type": "string",
          "minLength": 1
        },
        "requiredArtifact": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "requiredStatus": {
          "type": "string",
          "enum": [
            "passed",
            "present"
          ]
        },
        "forbiddenArtifacts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/transition_contract/properties/requiredArtifact"
          }
        },
        "guardId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "axis",
        "fromPhase",
        "toPhase",
        "requiredArtifact",
        "requiredStatus",
        "forbiddenArtifacts",
        "guardId"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
