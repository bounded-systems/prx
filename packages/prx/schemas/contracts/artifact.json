{
  "$ref": "#/definitions/artifact_contract",
  "definitions": {
    "artifact_contract": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "schemaVersion": {
          "type": "string",
          "pattern": "^prx\\.[a-z][a-z0-9_]*\\.v\\d+$"
        },
        "requiredFields": {
          "minItems": 0,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "validationRef": {
          "type": "string",
          "pattern": "^(schema:.+|cas:\\/\\/sha256:[0-9a-f]{64}|deferred:GH-\\d+)$"
        },
        "persistence": {
          "type": "string",
          "enum": [
            "git",
            "dolt",
            "cas"
          ]
        },
        "composedOf": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        }
      },
      "required": [
        "type",
        "schemaVersion",
        "requiredFields",
        "validationRef",
        "persistence"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
