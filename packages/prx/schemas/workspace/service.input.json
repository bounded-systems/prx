{
  "$ref": "#/definitions/workspace_service_input",
  "definitions": {
    "workspace_service_input": {
      "type": "object",
      "properties": {
        "workspace_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{12}$"
        },
        "action": {
          "type": "string",
          "enum": [
            "start",
            "stop"
          ]
        },
        "auto": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "workspace_id",
        "action"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
