#!/usr/bin/env bash
set -euo pipefail

# setup-provenance-signing — materialize + verify hardened prx signing (GH-352).
#
# prx deployed in a dev environment IS production for prx, so signing is the
# identity layer. The declarative half (env wiring) is the home-manager module's
# `programs.prx.provenance` block; this is the one imperative step it can't do:
# derive each actor's PUBLIC key from the master and publish the trust map, then
# verify the loop. Idempotent — safe to re-run (e.g. after a master rotation).
#
# Prerequisites (set by the hm-module, or export them yourself):
#   PRX_PROVENANCE_MASTER_FILE  path to the agenix/sops-decrypted base64 master
#                               (32 bytes, mode 0600). Unset ⇒ zero-config dev
#                               master (bootstrap).
#   PRX_PROVENANCE_KEY=dev      per-actor signing mode (derives from the master).
#   PRX_REQUIRE_SIGNED_DERIVATIONS=1   fail-closed verification.
#
# Usage: packages/prx/scripts/setup-provenance-signing   (run from the repo root)

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
cd "$repo_root"

# Resolve the prx entrypoint: prefer a built binary, else run from source.
if command -v prx >/dev/null 2>&1; then
  prx() { command prx "$@"; }
elif [[ -x dist/prx ]]; then
  prx() { ./dist/prx "$@"; }
else
  prx() { bun packages/prx/scripts/pr_state.ts "$@"; }
fi

note() { printf '  %s\n' "$*" >&2; }
fail() { printf 'setup-provenance-signing: %s\n' "$*" >&2; exit 1; }

echo "== prx provenance signing ==" >&2

# 1) Master secret — the one thing this script never creates (it is a deployment
#    secret; mint with `head -c 32 /dev/urandom | base64`, encrypt with sops/agenix).
master="${PRX_PROVENANCE_MASTER_FILE:-}"
if [[ -n "$master" ]]; then
  [[ -f "$master" ]] || fail "PRX_PROVENANCE_MASTER_FILE=$master does not exist (agenix/sops not decrypted?)"
  perms="$(stat -c %a "$master" 2>/dev/null || stat -f %Lp "$master" 2>/dev/null || echo '?')"
  [[ "$perms" == "600" ]] || note "warning: master file perms are $perms (want 600) — tighten with: chmod 600 $master"
  note "master: $master (operator-supplied)"
else
  note "master: none configured ⇒ zero-config persisted dev master (bootstrap)."
  note "         set PRX_PROVENANCE_MASTER_FILE for the production operator master."
fi

# 2) Signing mode — per-actor requires dev / actor-dev.
case "${PRX_PROVENANCE_KEY:-}" in
  dev | actor-dev) note "mode: per-actor signing (PRX_PROVENANCE_KEY=${PRX_PROVENANCE_KEY})" ;;
  "") fail "PRX_PROVENANCE_KEY is unset — set it to 'dev' for per-actor signing." ;;
  *) note "mode: PRX_PROVENANCE_KEY=${PRX_PROVENANCE_KEY} (not per-actor; trust-map register expects dev/actor-dev)" ;;
esac

# 3) Publish the trust map: derive every actor's PUBLIC key, write ~/.config/prx/config.json.
echo "-- prx keymaker register --" >&2
prx keymaker register >&2

# 4) Verify: drift must be empty right after register (the trust map matches the
#    keys the master derives). Non-empty ⇒ the published map is stale.
echo "-- prx keymaker drift (must be clean) --" >&2
drift="$(prx keymaker drift --format json)"
if [[ "$drift" != '{"drift":[]}' ]]; then
  fail "trust map drift detected after register: $drift"
fi
note "drift: clean."

# 5) Enforcement posture.
case "${PRX_REQUIRE_SIGNED_DERIVATIONS:-}" in
  1 | true | on | yes) note "enforcement: ON (fail-closed verification)." ;;
  *) note "enforcement: OFF — set PRX_REQUIRE_SIGNED_DERIVATIONS=1 to verify fail-closed." ;;
esac

echo "== signing configured: per-actor keys derived, trust map published, drift clean ==" >&2
