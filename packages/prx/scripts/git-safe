#!/usr/bin/env bash
set -euo pipefail
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/tool-policy.sh"

if [[ $# -lt 1 ]]; then
  echo "git-safe: subcommand required" >&2
  exit 1
fi

subcommand="$1"
shift

case "$subcommand" in
  status)   echo "git-safe: prefer 'prx repo-status' (this is a safety wrapper)" >&2 ;;
  worktree) echo "git-safe: prefer 'prx worktree' (this is a safety wrapper)" >&2 ;;
  *)        echo "git-safe: prefer 'prx $subcommand' (this is a safety wrapper)" >&2 ;;
esac

case "$subcommand" in
  reset|clean|rebase|cherry-pick|config|clone|init|remote|gc)
    echo "git-safe: blocked subcommand '$subcommand'" >&2
    exit 1
    ;;
esac

enforce_policy_or_exit "git" "$subcommand"

case "$subcommand" in
  status|diff|log|show|rev-parse|branch|worktree|fetch|add|commit|restore|switch|checkout|merge|pull)
    exec git -C "${PWD}" "$subcommand" "$@"
    ;;
  push)
    exec git -C "${PWD}" "$subcommand" "$@"
    ;;
  *)
    echo "git-safe: unknown or disallowed subcommand '$subcommand'" >&2
    exit 1
    ;;
esac
