# slack.env — 1Password references ONLY. No secrets. Safe to commit.
# Resolved at runtime by `op run --env-file=slack.env -- <cmd>`; the real values
# are injected into the child process only, never written here or to history.
# Paths must match OP_VAULT / OP_ITEM in scripts/slack-setup.sh (default below).
SLACK_CLIENT_ID=op://Private/slack-scout/client_id
SLACK_CLIENT_SECRET=op://Private/slack-scout/credential
SLACK_TOKEN=op://Private/slack-scout/token
