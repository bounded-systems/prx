{
  "name": "prx",
  "private": true,
  "type": "module",
  "license": "PolyForm-Noncommercial-1.0.0",
  "workspaces": ["packages/*"],
  "scripts": {
    "pr-state": "bun run packages/prx/scripts/pr_state.ts",
    "prx:build": "bun install && mkdir -p dist && bun packages/prx/scripts/prx-compile.ts dist/prx",
    "prx:build:linux-arm64": "bun install && mkdir -p dist && bun packages/prx/scripts/prx-compile.ts dist/prx-linux-arm64 --target bun-linux-arm64",
    "health": "bun run packages/prx/scripts/code-health.ts",
    "typecov": "type-coverage --strict --at-least 98 --ignore-files '**/*.test.ts'",
    "doctor:agents": "bun run packages/prx/scripts/agent_doctor.ts",
    "doctor:agents:json": "bun run packages/prx/scripts/agent_doctor.ts --format json",
    "doctor:agents:strict": "bun run packages/prx/scripts/agent_doctor.ts --strict",
    "snapshot:help:check": "bun test packages/prx/test/scripts/cli_help_snapshot.test.ts packages/prx/test/pr-state/help/help.snapshot.test.ts",
    "snapshot:help:refresh": "bun run snapshot:help:check -- -u",
    "schemas:export": "bun run packages/prx/scripts/export-intake-schemas.ts && bun run packages/prx/scripts/export-scout-schemas.ts && bun run packages/prx/scripts/export-contract-schemas.ts && bun run packages/prx/scripts/export-audit-schemas.ts && bun run packages/prx/scripts/export-workspace-schema.ts && bun run packages/prx/scripts/export-readme-schema.ts && bun run packages/prx/scripts/export-graph-schema.ts && bun run packages/prx/scripts/export-health-schema.ts",
    "community:render": "bun run packages/prx/scripts/render-community.ts",
    "community:check": "bun run packages/prx/scripts/render-community.ts --check",
    "jsonld:render": "bun run packages/prx/scripts/gen-jsonld.ts",
    "jsonld:check": "bun run packages/prx/scripts/gen-jsonld.ts --check",
    "readme:render": "bun run packages/prx/scripts/gen-readme.ts",
    "readme:check": "bun run packages/prx/scripts/gen-readme.ts --check",
    "claude-context:render": "bun run packages/prx/scripts/gen-claude-context.ts",
    "claude-context:check": "bun run packages/prx/scripts/gen-claude-context.ts --check",
    "docs:render": "bun run jsonld:render && bun run readme:render && bun run community:render && bun run claude-context:render",
    "docs:check": "bun run community:check && bun run jsonld:check && bun run readme:check && bun run claude-context:check",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "test:dolt-smoke": "PRX_DOLT_SMOKE=1 bun test packages/prx/test/beads/hydrate.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "changeset": "bunx @changesets/cli@^2.27",
    "version-packages": "bunx @changesets/cli@^2.27 version",
    "release": "bunx @changesets/cli@^2.27 publish"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.162",
    "@bounded-systems/machine-schema": "workspace:*",
    "@bounded-systems/prx-config": "workspace:*",
    "@bounded-systems/prx-mux": "workspace:*",
    "@statelyai/inspect": "^0.7.1",
    "xstate": "^5.32.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "dependency-cruiser": "^17.4.3",
    "drizzle-kit": "^0.31.10",
    "knip": "^6.16.1",
    "madge": "^8.0.0",
    "type-coverage": "^2.29.7",
    "typescript": "^6.0.3"
  }
}
