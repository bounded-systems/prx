{
  "permissions": {
    "allow": [
      "Read(**)",
      "Grep(**)",
      "Glob(**)",
      "Bash(prx model:*)",
      "Bash(prx scout:*)",
      "Bash(prx routine:*)",
      "Bash(prx actions:*)",
      "Bash(prx contract:*)",
      "Bash(prx chain:*)",
      "Bash(prx repo:*)",
      "Bash(prx worktree:*)",
      "Bash(prx plan show:*)",
      "Bash(prx triage status:*)",
      "Bash(prx help:*)",
      "Bash(bun test:*)",
      "Bash(bun typecheck:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(bd ready:*)",
      "Bash(bd list:*)",
      "Bash(bd show:*)",
      "Bash(bd blocked:*)",
      "Bash(bd memories:*)",
      "Bash(bash .claude/org-repair.sh)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(git push --force:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git reset --hard:*)"
    ]
  },
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "haiku",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "75",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/ensure-beads.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/inject-org-context.sh"
          }
        ]
      }
    ]
  }
}
